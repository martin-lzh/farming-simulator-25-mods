<?xml version="1.0" encoding="utf-8"?>
<!-- Map Helper drawer: slides in on the right of the map page, under the Map Helper button.
     MHDrawerDialog:layout stacks the parts and fits the height to what is shown. -->
<GUI onOpen="onOpen" onClose="onClose" onCreate="onCreate">
    <GuiElement profile="newLayer"/>
    <GuiElement profile="mh_drawer" id="drawerPanel">
        <Bitmap profile="mh_drawerBg"/>
        <Text profile="mh_drawerTitle" id="titleText"/>
        <Text profile="mh_drawerStatus" id="statusText"/>
        <BoxLayout profile="mh_drawerActions" id="actionBox">
            <Button profile="mh_drawerAction" id="centerButton" onClick="onClickCenter">
                <ThreePartBitmap profile="mh_drawerActionBg"/>
            </Button>
            <Button profile="mh_drawerAction" id="createButton" text="$l10n_button_createJob" onClick="onClickCreate">
                <ThreePartBitmap profile="mh_drawerActionBg"/>
            </Button>
            <Button profile="mh_drawerAction" id="startStopButton" text="$l10n_button_startJob" onClick="onClickStartStop">
                <ThreePartBitmap profile="mh_drawerActionBg"/>
            </Button>
            <Button profile="mh_drawerAction" id="goToButton" text="$l10n_button_gotoJob" onClick="onClickGoTo">
                <ThreePartBitmap profile="mh_drawerActionBg"/>
            </Button>
            <Button profile="mh_drawerAction" id="clearButton" onClick="onClickClear">
                <ThreePartBitmap profile="mh_drawerActionBg"/>
            </Button>
        </BoxLayout>
        <Text profile="mh_drawerSection" id="queueTitle"/>
        <GuiElement profile="mh_queueRow" id="rowTemplate">
            <Text profile="mh_queueRowLabel" name="label"/>
            <Button profile="mh_queueRowRemove" name="remove" text="$l10n_button_delete">
                <ThreePartBitmap profile="mh_drawerActionBg"/>
            </Button>
        </GuiElement>
        <ScrollingLayout profile="mh_queueRows" id="queueRows"/>
        <Text profile="mh_queueEmpty" id="queueEmptyText"/>
        <BoxLayout profile="mh_drawerButtonBox">
            <Button profile="buttonBack" text="$l10n_button_back" onClick="onClickBack"/>
        </BoxLayout>
    </GuiElement>
    <GUIProfiles>
        <Profile name="mh_drawer" extends="emptyPanel">
            <anchors value="1 1 1 1"/>
            <pivot value="1 1"/>
            <size value="400px 300px"/>
            <position value="-200px -200px"/>
        </Profile>
        <Profile name="mh_drawerBg" extends="baseReference" with="anchorStretchingYStretchingX">
            <imageColor value="$preset_fs25_colorMainDark_90"/>
        </Profile>
        <Profile name="mh_drawerTitle" extends="fs25_textDefault" with="anchorTopStretchingX">
            <size value="100% 30px"/>
            <absoluteSizeOffset value="40px 0px"/>
            <position value="0px -16px"/>
            <textSize value="22px"/>
            <textBold value="true"/>
            <textMaxNumLines value="1"/>
            <textLayoutMode value="scrolling"/>
        </Profile>
        <Profile name="mh_drawerStatus" extends="fs25_textDefault" with="anchorTopStretchingX">
            <size value="100% 40px"/>
            <absoluteSizeOffset value="40px 0px"/>
            <position value="0px -52px"/>
            <textSize value="15px"/>
            <textMaxNumLines value="3"/>
            <textVerticalAlignment value="top"/>
        </Profile>
        <Profile name="mh_drawerActions" extends="emptyPanel" with="anchorTopStretchingX">
            <size value="100% 190px"/>
            <absoluteSizeOffset value="40px 0px"/>
            <position value="0px -110px"/>
            <flowDirection value="vertical"/>
        </Profile>
        <Profile name="mh_drawerAction" extends="fs25_textDefault" with="anchorTopStretchingX">
            <size value="100% 30px"/>
            <margin value="0 0 0 7px"/>
            <iconSliceId value="noSlice"/>
            <iconColor value="$preset_colorTransparent"/>
            <imageSliceId value="noSlice"/>
            <imageColor value="$preset_colorTransparent"/>
            <textSize value="16px"/>
            <textBold value="true"/>
            <textUpperCase value="true"/>
            <textOffset value="10px 0px"/>
            <textFocusedColor value="$preset_fs25_colorMainDark"/>
            <textHighlightedColor value="$preset_fs25_colorMainDark"/>
            <textDisabledColor value="$preset_colorDisabled"/>
        </Profile>
        <Profile name="mh_drawerActionBg" extends="baseReference" with="anchorStretchingYStretchingX">
            <imageSliceId value="gui.button_middle"/>
            <imageColor value="$preset_fs25_colorGreyListItem"/>
            <imageFocusedColor value="$preset_fs25_colorMainHighlight"/>
            <imageHighlightedColor value="$preset_fs25_colorMainHighlight"/>
            <startImageSize value="6px 0"/>
            <startImageSliceId value="gui.button_left"/>
            <startImageColor value="$preset_fs25_colorGreyListItem"/>
            <startImageFocusedColor value="$preset_fs25_colorMainHighlight"/>
            <startImageHighlightedColor value="$preset_fs25_colorMainHighlight"/>
            <endImageSize value="6px 0"/>
            <endImageSliceId value="gui.button_right"/>
            <endImageColor value="$preset_fs25_colorGreyListItem"/>
            <endImageFocusedColor value="$preset_fs25_colorMainHighlight"/>
            <endImageHighlightedColor value="$preset_fs25_colorMainHighlight"/>
        </Profile>
        <Profile name="mh_drawerSection" extends="fs25_textDefault" with="anchorTopStretchingX">
            <size value="100% 24px"/>
            <absoluteSizeOffset value="40px 0px"/>
            <position value="0px -318px"/>
            <textSize value="16px"/>
            <textBold value="true"/>
            <textUpperCase value="true"/>
        </Profile>
        <Profile name="mh_queueRows" extends="emptyPanel" with="anchorTopStretchingX">
            <size value="100% 204px"/>
            <absoluteSizeOffset value="40px 0px"/>
            <position value="0px -348px"/>
            <flowDirection value="vertical"/>
        </Profile>
        <Profile name="mh_queueRow" extends="emptyPanel" with="anchorTopStretchingX">
            <height value="34px"/>
        </Profile>
        <Profile name="mh_queueRowLabel" extends="fs25_textDefault" with="anchorMiddleLeft">
            <size value="236px 28px"/>
            <position value="4px 0px"/>
            <textSize value="15px"/>
            <textLayoutMode value="scrolling"/>
        </Profile>
        <Profile name="mh_queueRowRemove" extends="mh_drawerAction" with="anchorMiddleRight">
            <size value="110px 28px"/>
            <margin value="0 0 0 0"/>
            <textSize value="14px"/>
        </Profile>
        <Profile name="mh_queueEmpty" extends="fs25_textDefault" with="anchorTopStretchingX">
            <size value="100% 60px"/>
            <absoluteSizeOffset value="40px 0px"/>
            <position value="0px -350px"/>
            <textSize value="15px"/>
            <textMaxNumLines value="3"/>
            <textVerticalAlignment value="top"/>
        </Profile>
        <Profile name="mh_drawerButtonBox" extends="fs25_dialogButtonBox">
            <position value="0px 14px"/>
        </Profile>
    </GUIProfiles>
</GUI>
