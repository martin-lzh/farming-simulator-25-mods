<?xml version="1.0" encoding="utf-8"?>
<GUI onOpen="onOpen" onClose="onClose" onCreate="onCreate">
    <GuiElement profile="newLayer"/>
    <Bitmap profile="dialogFullscreenBg" id="dialogBg"/>
    <GuiElement profile="fs25_dialogBg" id="dialogElement" size="860px 500px">
        <ThreePartBitmap profile="fs25_dialogBgMiddleSmall"/>
        <ThreePartBitmap profile="fs25_dialogBgTopSmall"/>
        <ThreePartBitmap profile="fs25_dialogBgBottom"/>
        <GuiElement profile="fs25_dialogContentContainer" id="contentContainer">
            <Text profile="fs25_dialogTitle" id="dialogTitleElement" position="0px -35px"/>
            <Text profile="fs25_dialogText" id="explanationElement" position="0px -80px" size="740px 90px"/>
            <GuiElement profile="apm_productRow" id="rowTemplate">
                <Text profile="apm_productName" name="productName"/>
                <MultiTextOption profile="apm_productMode" name="mode"/>
            </GuiElement>
            <ScrollingLayout profile="apm_productRows" id="productRows"/>
        </GuiElement>
        <BoxLayout profile="fs25_dialogButtonBox">
            <Button profile="buttonBack" text="$l10n_button_back" onClick="onClickBack"/>
            <Bitmap profile="fs25_dialogButtonBoxSeparator"/>
            <Button profile="buttonOK" text="$l10n_button_ok" onClick="onClickOk"/>
        </BoxLayout>
    </GuiElement>
    <GUIProfiles>
        <Profile name="apm_productRows" extends="emptyPanel" with="anchorBottomCenter">
            <size value="760px 230px"/>
            <position value="0px 25px"/>
            <flowDirection value="vertical"/>
        </Profile>
        <Profile name="apm_productRow" extends="emptyPanel" with="anchorTopStretchingX">
            <height value="56px"/>
        </Profile>
        <Profile name="apm_productName" extends="fs25_textDefault" with="anchorMiddleLeft">
            <position value="12px 0px"/>
            <size value="290px 30px"/>
            <textSize value="18px"/>
            <textLayoutMode value="scrolling"/>
        </Profile>
        <Profile name="apm_productMode" extends="fs25_multiTextOption" with="anchorMiddleRight">
            <position value="-12px 0px"/>
            <width value="430px"/>
        </Profile>
    </GUIProfiles>
</GUI>
